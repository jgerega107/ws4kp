<%- include('header.ejs', {
  titleDual:{ top: 'UniFi' , bottom: 'WAN Performance' },
  hasTime: true,
  logoSrc: 'images/observability/eggman-console.png',
  logoAlt: 'Eggman system operator',
  logoClass: 'observability-logo'
}) %>
<div class="main has-scroll has-box observability unifi-wan-performance can-enhance">
  <div class="observability-heading"><div class="entity-name"></div></div>
  <div class="chart-grid">
    <div class="metric-card metric-green legend-bottom wide-axis">
      <div class="chart-heading"><span>Traffic / 1H</span><span class="traffic-value"></span></div>
      <div class="trend-chart traffic-chart"></div>
    </div>
    <div class="metric-card metric-yellow legend-bottom">
      <div class="chart-heading"><span>Capacity / 1H</span><span class="capacity-value"></span></div>
      <div class="trend-chart capacity-chart"></div>
    </div>
    <div class="metric-card metric-blue legend-bottom">
      <div class="chart-heading"><span>Uptime / 1H</span><span class="uptime-value"></span></div>
      <div class="trend-chart uptime-chart"></div>
    </div>
    <div class="metric-card metric-purple legend-bottom wide-axis">
      <div class="chart-heading"><span>Speed Test / 1H</span><span class="speedtest-value"></span></div>
      <div class="trend-chart speedtest-chart"></div>
    </div>
  </div>
</div>
