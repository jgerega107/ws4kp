<%- include('header.ejs', {
  titleDual:{ top: 'UniFi' , bottom: 'Device Health' },
  hasTime: true,
  logoSrc: 'images/observability/eggman-console.png',
  logoAlt: 'Eggman system operator',
  logoClass: 'observability-logo'
}) %>
<div class="main has-scroll has-box observability unifi-device-health can-enhance">
  <div class="observability-heading"><div class="entity-name"></div></div>
  <div class="chart-grid">
    <div class="metric-card metric-blue">
      <div class="chart-heading"><span>CPU / 1H</span><span class="cpu-value"></span></div>
      <div class="trend-chart cpu-chart"></div>
    </div>
    <div class="metric-card metric-green">
      <div class="chart-heading"><span>Memory / 1H</span><span class="memory-value"></span></div>
      <div class="trend-chart memory-chart"></div>
    </div>
    <div class="metric-card metric-red">
      <div class="chart-heading"><span>Temp / 1H</span><span class="temperature-value"></span></div>
      <div class="trend-chart temperature-chart"></div>
    </div>
    <div class="metric-card metric-yellow legend-bottom wide-axis">
      <div class="chart-heading"><span>Traffic / 1H</span><span class="uptime-value"></span></div>
      <div class="trend-chart traffic-chart"></div>
    </div>
  </div>
</div>
